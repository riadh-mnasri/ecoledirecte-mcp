{
  "name": "ecoledirecte-mcp",
  "version": "0.1.0",
  "description": "Serveur MCP pour interroger un compte EcoleDirecte (notes, devoirs, absences, messages) depuis Claude, en local, sans jamais partager ses identifiants avec qui que ce soit.",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "ecoledirecte",
    "claude",
    "claude-desktop"
  ],
  "author": "Riadh MNASRI",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "bin": {
    "ecoledirecte-mcp": "dist/index.js",
    "ecoledirecte-mcp-init": "dist/cli/init.js"
  },
  "homepage": "https://github.com/riadh-mnasri/ecoledirecte-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riadh-mnasri/ecoledirecte-mcp.git"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
